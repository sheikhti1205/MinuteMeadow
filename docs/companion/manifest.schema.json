{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MinuteMeadow pack manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "version", "name", "author", "license", "preview", "canvas", "palette", "layers", "clips", "assets"],
  "properties": {
    "schema": {"const": "companion.pack/1"},
    "id": {"type": "string", "maxLength": 128, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)+$"},
    "version": {"$ref": "#/$defs/version"},
    "name": {"type": "string", "minLength": 1, "maxLength": 64},
    "author": {"type": "string", "minLength": 1, "maxLength": 64},
    "license": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9 .+()\\-]{0,63}$"},
    "preview": {"$ref": "#/$defs/assetPath"},
    "description": {"type": "string", "minLength": 1, "maxLength": 280},
    "attribution": {"type": "string", "minLength": 1, "maxLength": 512},
    "homepage": {"type": "string", "minLength": 9, "maxLength": 200, "pattern": "^https://"},
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minVersion"],
      "properties": {"minVersion": {"$ref": "#/$defs/version"}}
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": {"type": "integer", "minimum": 8, "maximum": 512},
        "height": {"type": "integer", "minimum": 8, "maximum": 512}
      }
    },
    "palette": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"}
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "z"],
        "properties": {
          "id": {"$ref": "#/$defs/identifier"},
          "z": {"type": "integer", "minimum": 0, "maximum": 7},
          "parent": {"$ref": "#/$defs/identifier"},
          "offset": {"$ref": "#/$defs/point"},
          "pivot": {"$ref": "#/$defs/point"},
          "rotationDegrees": {"type": "number", "minimum": -3600, "maximum": 3600},
          "scale": {
            "allOf": [
              {"$ref": "#/$defs/point"},
              {"properties": {
                "x": {"minimum": 0.05, "maximum": 8},
                "y": {"minimum": 0.05, "maximum": 8}
              }}
            ]
          },
          "opacity": {"type": "number", "minimum": 0, "maximum": 1},
          "visible": {"type": "boolean"}
        }
      }
    },
    "clips": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "fps", "loop", "frames"],
        "properties": {
          "id": {"$ref": "#/$defs/identifier"},
          "fps": {"type": "integer", "minimum": 1, "maximum": 30},
          "loop": {"type": "boolean"},
          "durationMs": {"type": "integer", "minimum": 1, "maximum": 120000},
          "tracks": {
            "type": "array",
            "maxItems": 48,
            "items": {"$ref": "#/$defs/track"}
          },
          "events": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "timeMs"],
              "properties": {
                "id": {"$ref": "#/$defs/identifier"},
                "timeMs": {"type": "integer", "minimum": 0, "maximum": 120000}
              }
            }
          },
          "state": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "priority": {"type": "integer", "minimum": -10, "maximum": 100},
              "interruptible": {"type": "boolean"},
              "transitionMs": {"type": "integer", "minimum": 0, "maximum": 1000}
            }
          },
          "frames": {
            "type": "array",
            "minItems": 1,
            "maxItems": 120,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["layer", "asset", "rect"],
              "properties": {
                "layer": {"$ref": "#/$defs/identifier"},
                "asset": {"$ref": "#/$defs/assetPath"},
                "rect": {"$ref": "#/$defs/rectangle"}
              }
            }
          }
        }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "bytes"],
        "properties": {
          "path": {"anyOf": [{"$ref": "#/$defs/assetPath"}, {"$ref": "#/$defs/wavePath"}]},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "bytes": {"type": "integer", "minimum": 1, "maximum": 524288}
        }
      }
    },
    "sounds": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event", "asset"],
        "properties": {
          "event": {"$ref": "#/$defs/identifier"},
          "asset": {"$ref": "#/$defs/wavePath"},
          "volume": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    }
  },
  "$defs": {
    "version": {"type": "string", "pattern": "^[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}$"},
    "identifier": {"type": "string", "pattern": "^[a-z0-9_-]{1,24}$"},
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": {"type": "number", "minimum": -2048, "maximum": 2048},
        "y": {"type": "number", "minimum": -2048, "maximum": 2048}
      }
    },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layer", "property", "keyframes"],
      "properties": {
        "layer": {"$ref": "#/$defs/identifier"},
        "property": {"enum": ["offsetX", "offsetY", "rotationDegrees", "scaleX", "scaleY", "opacity"]},
        "keyframes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 120,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["timeMs", "value"],
            "properties": {
              "timeMs": {"type": "integer", "minimum": 0, "maximum": 120000},
              "value": {"type": "number"},
              "easing": {"enum": ["step", "linear"]}
            }
          }
        }
      }
    },
    "assetPath": {
      "type": "string",
      "minLength": 5,
      "maxLength": 120,
      "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))(?=.*\\.[Pp][Nn][Gg]$)[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+){0,3}$"
    },
    "wavePath": {
      "type": "string",
      "maxLength": 120,
      "pattern": "^sounds/(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+){0,2}\\.[Ww][Aa][Vv]$"
    },
    "rectangle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "w", "h"],
      "properties": {
        "x": {"type": "integer", "minimum": 0, "maximum": 511},
        "y": {"type": "integer", "minimum": 0, "maximum": 511},
        "w": {"type": "integer", "minimum": 1, "maximum": 512},
        "h": {"type": "integer", "minimum": 1, "maximum": 512}
      }
    }
  }
}
