{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Companion Focus pack manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "version", "name", "author", "license", "preview", "canvas", "palette", "layers", "clips", "assets"],
  "properties": {
    "schema": {"const": "companion.pack/1"},
    "id": {"type": "string", "maxLength": 128, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)+$"},
    "version": {"$ref": "#/$defs/version"},
    "name": {"type": "string", "minLength": 1, "maxLength": 64},
    "author": {"type": "string", "minLength": 1, "maxLength": 64},
    "license": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9 .+()\\-]{0,63}$"},
    "preview": {"$ref": "#/$defs/assetPath"},
    "description": {"type": "string", "minLength": 1, "maxLength": 280},
    "attribution": {"type": "string", "minLength": 1, "maxLength": 512},
    "homepage": {"type": "string", "minLength": 9, "maxLength": 200, "pattern": "^https://"},
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minVersion"],
      "properties": {"minVersion": {"$ref": "#/$defs/version"}}
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": {"type": "integer", "minimum": 8, "maximum": 512},
        "height": {"type": "integer", "minimum": 8, "maximum": 512}
      }
    },
    "palette": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"}
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "z"],
        "properties": {
          "id": {"$ref": "#/$defs/identifier"},
          "z": {"type": "integer", "minimum": 0, "maximum": 7}
        }
      }
    },
    "clips": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "fps", "loop", "frames"],
        "properties": {
          "id": {"$ref": "#/$defs/identifier"},
          "fps": {"type": "integer", "minimum": 1, "maximum": 30},
          "loop": {"type": "boolean"},
          "frames": {
            "type": "array",
            "minItems": 1,
            "maxItems": 120,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["layer", "asset", "rect"],
              "properties": {
                "layer": {"$ref": "#/$defs/identifier"},
                "asset": {"$ref": "#/$defs/assetPath"},
                "rect": {"$ref": "#/$defs/rectangle"}
              }
            }
          }
        }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "bytes"],
        "properties": {
          "path": {"$ref": "#/$defs/assetPath"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "bytes": {"type": "integer", "minimum": 1, "maximum": 524288}
        }
      }
    }
  },
  "$defs": {
    "version": {"type": "string", "pattern": "^[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}$"},
    "identifier": {"type": "string", "pattern": "^[a-z0-9_-]{1,24}$"},
    "assetPath": {
      "type": "string",
      "minLength": 5,
      "maxLength": 120,
      "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))(?=.*\\.[Pp][Nn][Gg]$)[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+){0,3}$"
    },
    "rectangle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "w", "h"],
      "properties": {
        "x": {"type": "integer", "minimum": 0, "maximum": 511},
        "y": {"type": "integer", "minimum": 0, "maximum": 511},
        "w": {"type": "integer", "minimum": 1, "maximum": 512},
        "h": {"type": "integer", "minimum": 1, "maximum": 512}
      }
    }
  }
}
